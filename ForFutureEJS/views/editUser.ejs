<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    
    <form method="post" action="/admin/editUser/<%= encodeURIComponent(selectedUser.email) %>">
        <h1>Edit User</h1>
        <div class="mb-3">
            <label for ="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="<%= selectedUser.email %>" required>
        </div>
        <div class="mb-3">
            <label for="display_name" class="form-label">Display name</label>
            <input type="text" class="form-control" id="display_name" name="display_name" value="<%= selectedUser.display_name %>" required>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
        <a class="btn btn-secondary" href="/admin/greg">Cancel</a>
    </form>
</body>
</html>
