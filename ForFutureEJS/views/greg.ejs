<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Users</h1>
        <a class="btn btn-success" href="/admin/addUser">Add User</a>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>action</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td><%=user.display_name%></td>
                    <td><%=user.email%></td>
                    <td>
                        <a class="btn btn-secondary" href="/admin/editUser/<%= encodeURIComponent(user.email) %>" >edit</a>
                        <form method="post" class="d-inline" action="/admin/deleteUser/<%= encodeURIComponent(user.email) %>" method="POST" class="d-inline"
                              onsubmit="return confirm('Delete <%= user.email %>?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>