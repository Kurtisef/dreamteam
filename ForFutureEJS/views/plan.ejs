<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>BYU Gym Planner | Plan visit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Public+Sans:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<style>.screen { display: block; }</style>
</head>
<body>
<input class="sr" type="radio" name="t" id="t-home" aria-label="Home">
<input class="sr" type="radio" name="t" id="t-live" aria-label="Live feed">
<input class="sr" type="radio" name="t" id="t-week" aria-label="Week view">
<input class="sr" type="radio" name="t" id="t-plan" checked aria-label="Plan your visit">

<div class="app">
<header class="top"><div class="in">
  <h1>BYU Gym Planner</h1>
  <p>Know before you go. For BYU students and faculty.</p>
  <span id="auth-user" class="auth-user" aria-live="polite"><% if (typeof user !== 'undefined' && user) { %>Logged in as <%= user.display_name %><% } %></span>
  <button id="auth-btn" class="auth-btn" data-logged-in="<%= user ? 'true' : 'false' %>" type="button"><%= user ? 'Log out' : 'Log in' %></button>
  <nav class="tabs" aria-label="Screens">
    <a href="/home">Home</a>
    <a href="/live">Live feed</a><a href="/week">Week view</a>
    <a href="/plan" aria-current="page">Plan visit</a>
  </nav>
</div></header>

<main>
  <% const currentUser = typeof user !== 'undefined' ? user : null; %>
<section class="screen plan" aria-label="Plan a visit">
  <h2>Plan a visit</h2>
    <p class="lead">Log your intended workout window and equipment needs. Max 2 hours per day, up to 7 days in advance.</p>
  <% if (!currentUser) { %>
  <div id="plan-gate" class="card plan-gate">
      <h3>Log in to reserve a workout window</h3>
      <p class="mute">You need an active profile to schedule gym visits and select equipment.</p>
      <button type="button" id="plan-login-trigger" class="btn-primary auth-trigger">Log in or create a profile</button>
    </div>
  <% } else if (currentUser.role === 'admin') { %>
  <div class="card plan-gate" role="status">
    <h3>Admins cannot plan visits</h3>
    <p class="mute">Please log in to your personal account to plan your own visit.</p>
  </div>
  <% } else { %>
  <div id="plan-content" class="plan-grid">
    <div class="plan-left-column">
      <form id="plan-form" class="card plan-form" novalidate>
        <h3>New reservation</h3>

        <div class="field-row">
          <div class="field">
            <label for="plan-date">Date</label>
            <input type="date" id="plan-date" data-gym-time-zone="<%= gymTimeZone %>" required>
          </div>
          <div class="field">
            <label for="plan-time">Start time</label>
            <select id="plan-time" required>
              <option value="">Choose a date first</option>
            </select>
          </div>
          <div class="field">
            <label for="plan-duration">Duration</label>
            <select id="plan-duration" required>
              <option value="30">30 min</option>
              <option value="60" selected>1 hour</option>
              <option value="90">1.5 hours</option>
              <option value="120">2 hours</option>
            </select>
          </div>
        </div>

        <p id="plan-schedule" class="mute" role="status" aria-live="polite">Loading schedule…</p>

        <fieldset class="equip-group">
          <legend>Intended equipment <span class="mute">(select at least one)</span></legend>
          <div class="equip-checks">
            <label class="check-pill">
              <input type="checkbox" name="equipment" value="Racks">
              <span>Racks</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="equipment" value="Dumbbells">
              <span>Dumbbells</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="equipment" value="Cable stacks">
              <span>Cable stacks</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="equipment" value="Weight machines">
              <span>Weight machines</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="equipment" value="Cardio machines">
              <span>Cardio machines</span>
            </label>
          </div>
        </fieldset>

        <p id="plan-msg" role="status" aria-live="polite"></p>
        <button type="submit" id="plan-submit" class="btn-primary">Reserve time</button>
      </form>

      <div class="card visit-history-card">
        <section class="visit-history" aria-labelledby="visit-history-title">
          <div class="visit-history-header">
            <h3 id="visit-history-title">Visits from the last 7 days</h3>
            <label class="hide-responded-label" for="hide-responded-visits">
              <input type="checkbox" id="hide-responded-visits">
              <span>Hide visits already answered</span>
            </label>
          </div>
          <p class="mute attendance-note">Your response is saved with the reservation. You can change it later.</p>
          <p id="attendance-message" class="mute attendance-message" role="status" aria-live="polite"></p>
          <div id="visit-history-list" class="plan-list" aria-live="polite">
            <p class="mute">No visits from the last 7 days.</p>
          </div>
        </section>
      </div>
    </div>

      <div class="card plan-list-card">
        <div class="plan-list-header">
          <h3>Your upcoming visits</h3>
          <span id="daily-quota-badge" class="quota-badge">0 / 120 min on selected date</span>
        </div>
        <div id="plan-list" class="plan-list">
          <p class="mute">No upcoming visits scheduled.</p>
        </div>
      </div>
    </div>
  <% } %>
</section>
</main>
</div>
<%- include('partials/auth-dialog') %>
<script src="/auth.js" defer></script>
<script src="/plan.js" defer></script>
</body>
</html>
