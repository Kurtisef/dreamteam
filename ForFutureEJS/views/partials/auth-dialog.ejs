<dialog id="auth-dialog" class="auth-dialog" aria-labelledby="auth-title">
  <form id="auth-form" action="/login" method="post" novalidate>
    <h2 id="auth-title">Log in</h2>
    <input type="hidden" name="mode" id="auth-mode" value="login">
    <input type="hidden" name="return_to" value="<%= currentPath %>">

    <label for="auth-display-name">Username</label>
    <input id="auth-display-name" name="display_name" type="text" autocomplete="username" required>

    <label for="auth-email">Email</label>
    <input id="auth-email" name="email" type="email" autocomplete="email" required>

    <p id="auth-msg" role="status" aria-live="polite"></p>
    <button id="auth-submit" type="submit">Log in</button>
    <button id="auth-toggle" type="button" class="link">New here? Create a profile</button>
    <button id="auth-close" type="button" class="link">Cancel</button>
  </form>
</dialog>
