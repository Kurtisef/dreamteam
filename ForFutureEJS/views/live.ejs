<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>BYU Gym Planner | Live feed</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Public+Sans:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<style>.screen { display: block; }</style>
</head>
<body>
<input class="sr" type="radio" name="t" id="t-home" aria-label="Home">
<input class="sr" type="radio" name="t" id="t-live" checked aria-label="Live feed">
<input class="sr" type="radio" name="t" id="t-week" aria-label="Week view">
<input class="sr" type="radio" name="t" id="t-plan" aria-label="Plan your visit">

<div class="app">
<header class="top"><div class="in">
  <h1>BYU Gym Planner</h1>
  <p>Know before you go. For BYU students and faculty.</p>
  <span id="auth-user" class="auth-user" aria-live="polite"><% if (typeof user !== 'undefined' && user) { %>Logged in as <%= user.display_name %><% } %></span>
  <button id="auth-btn" class="auth-btn" data-logged-in="<%= user ? 'true' : 'false' %>" type="button"><%= user ? 'Log out' : 'Log in' %></button>
  <nav class="tabs" aria-label="Screens">
    <a href="/home">Home</a>
    <a href="/live" aria-current="page">Live feed</a><a href="/week">Week view</a>
    <a href="/plan">Plan visit</a>
  </nav>
</div></header>

<main>
  <% const currentUser = typeof user !== 'undefined' ? user : null; %>
<section class="screen live" aria-label="Live feed">
  <div class="cams-h"><h2>Live feed</h2><p>Inside the gym.</p></div>
  <% if (!currentUser) { %>
  <div class="card plan-gate" role="status">
    <h3>Sign in to view the live camera feed</h3>
    <p class="mute">You need to be signed in to view the gym cameras.</p>
    <button type="button" class="btn-primary auth-trigger">Log in</button>
  </div>
  <% } else { %>
  <div class="cams single-feed">
      <figure class="cam">
        <div class="feed">
          <iframe
            id="gym-twitch-player"
            class="twitch-player"
            title="GymTracker live stream"
            src="about:blank"
            allow="autoplay; picture-in-picture"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </figure>
    </div>
    <script>
      const twitchPlayer = document.getElementById('gym-twitch-player');
      const twitchUrl = new URL('https://player.twitch.tv/');
      twitchUrl.searchParams.set('channel', 'GymTracker');
      twitchUrl.searchParams.set('parent', window.location.hostname);
      twitchUrl.searchParams.set('muted', 'true');
      twitchPlayer.src = twitchUrl.toString();
    </script>
  <% } %>
</section>
</main>
</div>
<%- include('partials/auth-dialog') %>
<script src="/auth.js" defer></script>
<% if (user && user.role === 'user') { %><script src="/app-open.js" defer></script><% } %>
</body>
</html>
